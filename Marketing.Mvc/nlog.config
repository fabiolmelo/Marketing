<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target name="file" xsi:type="File" fileName="./DadosApp/Logs/${shortdate}.log"
            layout="${longdate}|${uppercase:${level}}|${message}|${exception:format=ToString}" />
  </targets>

  <rules>
    <!-- Microsoft e System: apenas Error para cima -->
    <logger name="Microsoft.*" minlevel="Trace" maxlevel="Warn" final="true" />
    <logger name="System.*"    minlevel="Trace" maxlevel="Warn" final="true" />

    <!-- Todos os seus logs -->
    <logger name="*" minlevel="Trace" writeTo="file" />
  </rules>

</nlog>